# ── Cluster & Services On-Demand Control ────────────────────
./infrastructure/k8s/cluster.sh stop                  # Stop Kind cluster (0 RAM/CPU, no auto-start)
./infrastructure/k8s/cluster.sh start                 # Start Kind cluster on-demand
./infrastructure/k8s/cluster.sh status                # View cluster status
./infrastructure/k8s/cluster.sh disable-autostart     # Ensure Docker won't auto-start cluster

# Scale services on-demand (keep DB/Kafka/RabbitMQ running):
./infrastructure/k8s/cluster.sh stop-services dev     # Scale down all microservices to 0 replicas
./infrastructure/k8s/cluster.sh start-services dev    # Scale up all microservices to 1 replica
./infrastructure/k8s/cluster.sh start-svc appointment-service dev  # Start only 1 service
./infrastructure/k8s/cluster.sh stop-svc appointment-service dev   # Stop only 1 service

