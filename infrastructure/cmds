# ── PostgreSQL ───────────────────────────────────────────────
# 1. Port-forward (run in a separate terminal, keep it open)
kubectl port-forward svc/medtrust-postgres 5432:5432 -n medtrust-dev

# 2. Connect with psql (requires postgresql-client installed)
psql -h localhost -p 5432 -U medtrust -d medtrust
#    Password: medtrust  (check secret: kubectl get secret medtrust-postgres-secret -n medtrust-dev -o jsonpath='{.data.POSTGRES_PASSWORD}' | base64 -d)

# 3. Useful psql queries
#    \l           – list all databases
#    \c <db>      – connect to a database
#    \dt          – list tables in current schema
#    \d <table>   – describe a table
#    SELECT * FROM appointments LIMIT 10;

# 4. One-liner: run a query without interactive shell
kubectl exec -n medtrust-dev deployment/medtrust-postgres -- \
  psql -U medtrust -d medtrust -c "SELECT * FROM appointments LIMIT 5;"


# ── Kafka ─────────────────────────────────────────────────────
# 1. Port-forward
kubectl port-forward svc/medtrust-kafka 9092:9092 -n medtrust-dev

# 2. List topics (exec directly into pod — no local client needed)
kubectl exec -n medtrust-dev deploy/medtrust-kafka -- \
  kafka-topics.sh --bootstrap-server localhost:9092 --list

# 3. Describe a topic
kubectl exec -n medtrust-dev deploy/medtrust-kafka -- \
  kafka-topics.sh --bootstrap-server localhost:9092 --describe --topic appointment-events

# 4. Consume messages from a topic (live tail)
kubectl exec -it -n medtrust-dev deploy/medtrust-kafka -- \
  kafka-console-consumer.sh --bootstrap-server localhost:9092 \
  --topic appointment-events --from-beginning

# 5. Produce a test message
kubectl exec -it -n medtrust-dev deploy/medtrust-kafka -- \
  kafka-console-producer.sh --bootstrap-server localhost:9092 \
  --topic appointment-events

# 6. Check consumer group lag
kubectl exec -n medtrust-dev deploy/medtrust-kafka -- \
  kafka-consumer-groups.sh --bootstrap-server localhost:9092 --list
kubectl exec -n medtrust-dev deploy/medtrust-kafka -- \
  kafka-consumer-groups.sh --bootstrap-server localhost:9092 \
  --describe --group medtrust-appointment-group


# ── RabbitMQ ──────────────────────────────────────────────────
# 1. Port-forward management UI (port 15672) + AMQP (port 5672)
kubectl port-forward svc/medtrust-rabbitmq 15672:15672 5672:5672 -n medtrust-dev

# 2. Open Management UI in browser:
#    http://localhost:15672
#    Default credentials: guest / guest
#    (or check secret: kubectl get secret medtrust-rabbitmq-secret -n medtrust-dev -o jsonpath='{.data.RABBITMQ_DEFAULT_PASS}' | base64 -d)

# 3. rabbitmqctl via exec (no port-forward needed)
kubectl exec -n medtrust-dev deploy/medtrust-rabbitmq -- rabbitmqctl list_queues
kubectl exec -n medtrust-dev deploy/medtrust-rabbitmq -- rabbitmqctl list_exchanges
kubectl exec -n medtrust-dev deploy/medtrust-rabbitmq -- rabbitmqctl list_bindings
kubectl exec -n medtrust-dev deploy/medtrust-rabbitmq -- rabbitmqctl list_connections
kubectl exec -n medtrust-dev deploy/medtrust-rabbitmq -- rabbitmqctl status

# 4. Purge a queue (clear all unprocessed messages)
kubectl exec -n medtrust-dev deploy/medtrust-rabbitmq -- rabbitmqctl purge_queue sms.queue
